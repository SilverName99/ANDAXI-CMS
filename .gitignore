/vendor/
/.env
# Fișierul temporar al tools/verificare/configureaza.php (redenumit imediat în .env).
/.env.*.tmp
/.idea/
/.vscode/
*.log

# Datele de rulare ale fiecărui site (sesiuni, cache, copii, jurnale, importuri)
# nu intră niciodată în git. Rămân doar folderele goale, cu .gitkeep.
/storage/*
!/storage/*/
/storage/*/*
!/storage/*/.gitkeep
!/storage/cache/pages/
/storage/cache/pages/*
!/storage/cache/pages/.gitkeep
!/storage/import/.gitignore

# Fișiere scrise de aplicație în public/: încărcări, sitemap, reguli de cache.
/public/uploads/
/public/assets/.htaccess
/public/*.xml
# Fișierele publice ale temei site-ului: copiate din pachetul lui (tema/public/) la instalare și la fiecare
# actualizare (docs/PACHETE.md); în dezvoltare le servește tools/dev/router.php direct din pachet.
/public/tema/

# Datele fiecărui site (redirecționări, reguli SEO): dosarul site/ de pe server
# (sau SITE_DATE_DOSAR). Pachetele site-urilor existente stau în site-uri/<site>/.
/site/

# Ce trimite proprietarul de pe site-urile live (WP-10: sonda schemei, verificările agregate) și
# fixture-urile făcute din ele: numere și structură scoase din datele live, deci niciodată în git
# cât repo-ul e public (decizia OD-49). Pe server, rezultatele stau în storage/verificare/sonde/
# (ignorat mai sus, ca tot storage/).
/tools/dev/migrari/vechi/privat/

# Valorile private ale înghețării setărilor unui site (adresele de email, telefoanele, numele clientului:
# tools/inghetare/genereaza-setari.php le scrie aici, în fișierul din git rămân înlocuitori @exemplu.ro).
# Cât repo-ul e public nu intră în git (decizia OD-49); pe server stau lângă pachetul site-ului.
/site-uri/*/privat/
