APP_NAME="Bioscem Shop"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Europe/Bucharest

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bioscem_shop
DB_USERNAME=root
DB_PASSWORD=

ADMIN_DEFAULT_EMAIL=admin@bioscem.ro
# Parola primului administrator. Obligatorie la `php scripts/install.php`
# (minim 10 caractere); instalarea refuză să ruleze fără ea. Nu există parolă
# de rezervă în cod. După instalare o poți șterge de aici.
ADMIN_DEFAULT_PASSWORD=

# Banca Transilvania iPay: datele de acces primite de la bancă, separat pentru
# test (sandbox) și producție. Se completează DOAR în .env-ul de pe server,
# niciodată în git, pe email sau pe chat. Modificarea se aplică imediat.
# BT_IPAY_MODE=test folosește platforma de test a băncii; live = producție.
BT_IPAY_MODE=test
BT_IPAY_TEST_USER=
BT_IPAY_TEST_PASS=
BT_IPAY_TEST_CALLBACK_KEY=
BT_IPAY_LIVE_USER=
BT_IPAY_LIVE_PASS=
BT_IPAY_LIVE_CALLBACK_KEY=
# Doar pentru teste locale, cu un server care imită banca. Pe site-ul live rămâne gol.
BT_IPAY_BASE_URL_OVERRIDE=

# Licența cu pluginurile site-ului, semnată de CRM (vezi docs/PLUGINURI.md).
# LICENTA_CHEIE_PUBLICA = cheia publică Ed25519 a CRM-ului (base64); LICENTA_SITE =
# identificatorul site-ului în CRM. Fără ele (sau fără licență) site-ul merge doar
# cu nucleul: magazinul, blogul etc. nu apar. LICENTA_DOSAR gol = storage/licenta.
LICENTA_CHEIE_PUBLICA=
LICENTA_SITE=
LICENTA_DOSAR=

# Numele site-ului (litere mici, cifre, -; de exemplu bioscem). Îl folosesc
# `php scripts/migreaza.php` (implicit pentru --site) și `php scripts/install.php`:
# pașii migrărilor acelui site, cu înghețarea setărilor din pachetul lui
# (SITE_DATE_DOSAR; docs/MIGRARI.md). Gol = fără pașii vreunui site; cu un pachet
# care are setari-inghetate.json, gol e o eroare (migrările se opresc cu codul 2).
SITE_SLUG=

# Opriri de urgență (implicit pornite; 0 = ca înainte). SEO_TITLURI=0: titlurile și
# descrierile Google rămân cele scrise, fără regula titlurilor și fără descrieri automate.
# SEO_LIVRARE_RETUR=0: fără livrare și retur în datele structurate și în fluxul Merchant
# Center (docs/SEO.md). AVERTISMENT_PRODUSE=0: fără fereastra la adăugarea în coș, caseta
# și bifa obligatorie la finalizarea comenzii și blocul din email ale avertismentului pe
# produs (ex. „ATENȚIE – PRODUS REFRIGERAT”); textele din admin și confirmările vechi rămân.
# SEO_TITLURI=1
# SEO_LIVRARE_RETUR=1
# AVERTISMENT_PRODUSE=1
