# Docroot-ul (public_html/) unui site în așezarea din Etapa 2, lângă stub-ul index.php (docs/DEZVOLTARE.md,
# „Unde scrie codul”). Ca public/.htaccess de azi: fișierele care există (assets/, uploads/, sitemap-urile scrise
# de admin, .well-known/) se servesc direct, restul ajunge la index.php; /sitemap.xml și
# /sitemap-{tip}.xml sunt mereu cele construite din bază.
# În plus: niciun fișier cu punct în față (un .env sau .git rămas) și nicio listă de fișiere a unui dosar.
Options -Indexes
DirectoryIndex index.php

RewriteEngine On

RewriteRule (^|/)\.(?!well-known/) - [F,L]

RewriteRule ^sitemap\.xml$ index.php [L,QSA]
RewriteRule ^sitemap-(pagini|produse|categorii|marci|etichete|articole|blog-categorii|blog-etichete)\.xml$ index.php [L,QSA]

# WP-40 (B6): un fișier din /assets/ cerut cu ?v= (versiunea lui, data fișierului) nu se mai schimbă la aceeași adresă:
# browserul îl ține un an, fără să mai întrebe (immutable). Fără ?v=, ca înainte.
RewriteCond %{QUERY_STRING} (^|&)v=
RewriteRule ^assets/ - [E=AX_VERSIONAT:1]
<IfModule mod_headers.c>
    Header always set Cache-Control "public, max-age=31536000, immutable" env=AX_VERSIONAT
</IfModule>

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^ index.php [L,QSA]
