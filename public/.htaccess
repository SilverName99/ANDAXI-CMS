RewriteEngine On

# /sitemap.xml și /sitemap-{tip}.xml se construiesc din baza de date (rutele din src/Http/rute.php). Un fișier
# sitemap vechi rămas în public/ nu trebuie să le acopere.
RewriteRule ^sitemap\.xml$ index.php [L,QSA]
RewriteRule ^sitemap-(pagini|produse|categorii|marci|etichete|articole|blog-categorii|blog-etichete)\.xml$ index.php [L,QSA]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^ index.php [L,QSA]
